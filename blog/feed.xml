    &lt;span class=&quot;hljs-keyword&quot;&gt;let&lt;/span&gt; lineWeight = &lt;span class=&quot;hljs-title function_&quot;&gt;random&lt;/span&gt;(&lt;span class=&quot;hljs-number&quot;&gt;1.0&lt;/span&gt;, &lt;span class=&quot;hljs-number&quot;&gt;2.5&lt;/span&gt;);
