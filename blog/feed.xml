<updated>2026-10-12T00:00:00.000Z</updated>

<content type="html">&lt;p&gt;&lt;img src=&quot;posts/gentober2026/../../assets/gentober-day12.png&quot; alt=&quot;day picture&quot;/&gt;&lt;/p&gt;
&lt;pre&gt;&lt;code class=&quot;language-javascript&quot;&gt;&lt;span class=&quot;hljs-keyword&quot;&gt;const&lt;/span&gt; white = &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;#fff&amp;quot;&lt;/span&gt;;
&lt;span class=&quot;hljs-keyword&quot;&gt;const&lt;/span&gt; cyan = &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;#55ffff&amp;quot;&lt;/span&gt;;
&lt;span class=&quot;hljs-keyword&quot;&gt;const&lt;/span&gt; magenta = &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;#ff55ff&amp;quot;&lt;/span&gt;;

&lt;span class=&quot;hljs-keyword&quot;&gt;function&lt;/span&gt; &lt;span class=&quot;hljs-title function_&quot;&gt;setup&lt;/span&gt;(&lt;span class=&quot;hljs-params&quot;&gt;&lt;/span&gt;) {
  &lt;span class=&quot;hljs-title function_&quot;&gt;createCanvas&lt;/span&gt;(&lt;span class=&quot;hljs-number&quot;&gt;640&lt;/span&gt;, &lt;span class=&quot;hljs-number&quot;&gt;640&lt;/span&gt;);
  &lt;span class=&quot;hljs-title function_&quot;&gt;background&lt;/span&gt;(&lt;span class=&quot;hljs-number&quot;&gt;0&lt;/span&gt;);

  &lt;span class=&quot;hljs-comment&quot;&gt;// 1. Create a tiny 2x2 grid for a checkerboard/dither pattern&lt;/span&gt;
  patternImg = &lt;span class=&quot;hljs-title function_&quot;&gt;createGraphics&lt;/span&gt;(&lt;span class=&quot;hljs-number&quot;&gt;2&lt;/span&gt;, &lt;span class=&quot;hljs-number&quot;&gt;2&lt;/span&gt;);
  patternImg.&lt;span class=&quot;hljs-title function_&quot;&gt;noStroke&lt;/span&gt;();
  patternImg.&lt;span class=&quot;hljs-title function_&quot;&gt;background&lt;/span&gt;(&lt;span class=&quot;hljs-number&quot;&gt;250&lt;/span&gt;);          &lt;span class=&quot;hljs-comment&quot;&gt;// Primary color&lt;/span&gt;
  patternImg.&lt;span class=&quot;hljs-title function_&quot;&gt;fill&lt;/span&gt;(&lt;span class=&quot;hljs-number&quot;&gt;40&lt;/span&gt;);                 &lt;span class=&quot;hljs-comment&quot;&gt;// Secondary dither color&lt;/span&gt;
  patternImg.&lt;span class=&quot;hljs-title function_&quot;&gt;rect&lt;/span&gt;(&lt;span class=&quot;hljs-number&quot;&gt;0&lt;/span&gt;, &lt;span class=&quot;hljs-number&quot;&gt;0&lt;/span&gt;, &lt;span class=&quot;hljs-number&quot;&gt;1&lt;/span&gt;, &lt;span class=&quot;hljs-number&quot;&gt;1&lt;/span&gt;);
  patternImg.&lt;span class=&quot;hljs-title function_&quot;&gt;rect&lt;/span&gt;(&lt;span class=&quot;hljs-number&quot;&gt;1&lt;/span&gt;, &lt;span class=&quot;hljs-number&quot;&gt;1&lt;/span&gt;, &lt;span class=&quot;hljs-number&quot;&gt;1&lt;/span&gt;, &lt;span class=&quot;hljs-number&quot;&gt;1&lt;/span&gt;);

  &lt;span class=&quot;hljs-comment&quot;&gt;// 2. Convert p5.Graphics to an HTML Canvas Pattern&lt;/span&gt;
  &lt;span class=&quot;hljs-keyword&quot;&gt;let&lt;/span&gt; ctx = drawingContext;
  &lt;span class=&quot;hljs-keyword&quot;&gt;let&lt;/span&gt; pattern = ctx.&lt;span class=&quot;hljs-title function_&quot;&gt;createPattern&lt;/span&gt;(patternImg.&lt;span class=&quot;hljs-property&quot;&gt;canvas&lt;/span&gt;, &lt;span class=&quot;hljs-string&quot;&gt;&amp;#x27;repeat&amp;#x27;&lt;/span&gt;);

  &lt;span class=&quot;hljs-comment&quot;&gt;// 3. Apply pattern fill and draw standard p5 shapes&lt;/span&gt;
  ctx.&lt;span class=&quot;hljs-property&quot;&gt;fillStyle&lt;/span&gt; = pattern;
  &lt;span class=&quot;hljs-title function_&quot;&gt;stroke&lt;/span&gt;(&lt;span class=&quot;hljs-number&quot;&gt;127&lt;/span&gt;);
  &lt;span class=&quot;hljs-title function_&quot;&gt;strokeWeight&lt;/span&gt;(&lt;span class=&quot;hljs-number&quot;&gt;1&lt;/span&gt;);

  &lt;span class=&quot;hljs-title function_&quot;&gt;triangle&lt;/span&gt;(&lt;span class=&quot;hljs-number&quot;&gt;0&lt;/span&gt;, height, width/&lt;span class=&quot;hljs-number&quot;&gt;2&lt;/span&gt;, height/&lt;span class=&quot;hljs-number&quot;&gt;2&lt;/span&gt;, width, height);
  
  &lt;span class=&quot;hljs-keyword&quot;&gt;for&lt;/span&gt;(&lt;span class=&quot;hljs-keyword&quot;&gt;let&lt;/span&gt; i = &lt;span class=&quot;hljs-number&quot;&gt;5&lt;/span&gt;; i &amp;lt; &lt;span class=&quot;hljs-number&quot;&gt;25&lt;/span&gt;; i++) {
    &lt;span class=&quot;hljs-title function_&quot;&gt;fill&lt;/span&gt;(&lt;span class=&quot;hljs-title function_&quot;&gt;random&lt;/span&gt;([white,cyan,magenta]));
    &lt;span class=&quot;hljs-title function_&quot;&gt;circle&lt;/span&gt;(
