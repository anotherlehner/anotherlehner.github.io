    &lt;span class=&quot;hljs-variable language_&quot;&gt;this&lt;/span&gt;.&lt;span class=&quot;hljs-property&quot;&gt;h&lt;/span&gt; = width/&lt;span class=&quot;hljs-number&quot;&gt;2&lt;/span&gt;;
