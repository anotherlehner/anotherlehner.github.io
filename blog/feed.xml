<content type="html">&lt;p&gt;&lt;img src=&quot;posts/gentober2026/../../assets/gentober-day5.png&quot; alt=&quot;day picture&quot;/&gt;&lt;/p&gt;
&lt;pre&gt;&lt;code class=&quot;language-javascript&quot;&gt;&lt;span class=&quot;hljs-keyword&quot;&gt;const&lt;/span&gt; white = &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;#fff&amp;quot;&lt;/span&gt;;
&lt;span class=&quot;hljs-keyword&quot;&gt;const&lt;/span&gt; cyan = &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;#55ffff&amp;quot;&lt;/span&gt;;
&lt;span class=&quot;hljs-keyword&quot;&gt;const&lt;/span&gt; magenta = &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;#ff55ff&amp;quot;&lt;/span&gt;;

&lt;span class=&quot;hljs-keyword&quot;&gt;async&lt;/span&gt; &lt;span class=&quot;hljs-keyword&quot;&gt;function&lt;/span&gt; &lt;span class=&quot;hljs-title function_&quot;&gt;setup&lt;/span&gt;(&lt;span class=&quot;hljs-params&quot;&gt;&lt;/span&gt;) {
  &lt;span class=&quot;hljs-title function_&quot;&gt;createCanvas&lt;/span&gt;(&lt;span class=&quot;hljs-number&quot;&gt;640&lt;/span&gt;, &lt;span class=&quot;hljs-number&quot;&gt;640&lt;/span&gt;, &lt;span class=&quot;hljs-variable constant_&quot;&gt;WEBGL&lt;/span&gt;);
  &lt;span class=&quot;hljs-title function_&quot;&gt;background&lt;/span&gt;(&lt;span class=&quot;hljs-number&quot;&gt;0&lt;/span&gt;);

  &lt;span class=&quot;hljs-keyword&quot;&gt;let&lt;/span&gt; kpFont = &lt;span class=&quot;hljs-keyword&quot;&gt;await&lt;/span&gt; &lt;span class=&quot;hljs-title function_&quot;&gt;loadFont&lt;/span&gt;(&lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;KaPow.otf&amp;quot;&lt;/span&gt;);

  msgs = [
    &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;Can you give me your passport?&amp;quot;&lt;/span&gt;,
    &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;I need this paper stamped by border services&amp;quot;&lt;/span&gt;,
    &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;Do your have your work permit?&amp;quot;&lt;/span&gt;,
    &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;Do you have a study permit?&amp;quot;&lt;/span&gt;,
    &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;You need a &amp;lt;country&amp;gt; phone number&amp;quot;&lt;/span&gt;,
    &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;You need a &amp;lt;country&amp;gt; bank account&amp;quot;&lt;/span&gt;,
    &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;You need a &amp;lt;country&amp;gt; address&amp;quot;&lt;/span&gt;,
    &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;I&amp;#x27;ll need two forms of identification&amp;quot;&lt;/span&gt;,
    &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;I just need a stamp on this&amp;quot;&lt;/span&gt;,
    &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;You can book an appointment by phone&amp;quot;&lt;/span&gt;,
    &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;You can book an appointment online&amp;quot;&lt;/span&gt;,
    &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;Can I have the paperwork provided by your PODS agent?&amp;quot;&lt;/span&gt;,
    &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;I do this every day&amp;quot;&lt;/span&gt;,
    &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;The account was flagged as fraud&amp;quot;&lt;/span&gt;,
    &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;Let&amp;#x27;s reset your pin&amp;quot;&lt;/span&gt;,
    &lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;Let&amp;#x27;s set a pin for your account&amp;quot;&lt;/span&gt;,
