    mover.&lt;span class=&quot;hljs-title function_&quot;&gt;update&lt;/span&gt;();
  }
  mover.&lt;span class=&quot;hljs-title function_&quot;&gt;show&lt;/span&gt;();
  mover.&lt;span class=&quot;hljs-title function_&quot;&gt;checkEdges&lt;/span&gt;();

  &lt;span class=&quot;hljs-title function_&quot;&gt;stroke&lt;/span&gt;(&lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;#999&amp;quot;&lt;/span&gt;);
  &lt;span class=&quot;hljs-title function_&quot;&gt;strokeWeight&lt;/span&gt;(&lt;span class=&quot;hljs-number&quot;&gt;1&lt;/span&gt;);
  &lt;span class=&quot;hljs-title function_&quot;&gt;noFill&lt;/span&gt;();
  &lt;span class=&quot;hljs-title function_&quot;&gt;text&lt;/span&gt;(&lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;Apple&amp;quot;&lt;/span&gt;, &lt;span class=&quot;hljs-number&quot;&gt;8&lt;/span&gt;, height-&lt;span class=&quot;hljs-number&quot;&gt;10&lt;/span&gt;);
}
