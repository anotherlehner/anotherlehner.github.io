&lt;span class=&quot;hljs-keyword&quot;&gt;function&lt;/span&gt; &lt;span class=&quot;hljs-title function_&quot;&gt;draw&lt;/span&gt;(&lt;span class=&quot;hljs-params&quot;&gt;&lt;/span&gt;) {
  &lt;span class=&quot;hljs-title function_&quot;&gt;background&lt;/span&gt;(&lt;span class=&quot;hljs-string&quot;&gt;&amp;quot;#ddf0dd&amp;quot;&lt;/span&gt;);

  &lt;span class=&quot;hljs-keyword&quot;&gt;if&lt;/span&gt; (!paused) {
    &lt;span class=&quot;hljs-keyword&quot;&gt;let&lt;/span&gt; gravity = &lt;span class=&quot;hljs-title function_&quot;&gt;createVector&lt;/span&gt;(&lt;span class=&quot;hljs-number&quot;&gt;0&lt;/span&gt;, &lt;span class=&quot;hljs-number&quot;&gt;0.1&lt;/span&gt;);
    mover.&lt;span class=&quot;hljs-title function_&quot;&gt;applyForce&lt;/span&gt;(gravity);
  
    &lt;span class=&quot;hljs-keyword&quot;&gt;if&lt;/span&gt; (doWind) {
      mover.&lt;span class=&quot;hljs-title function_&quot;&gt;applyForce&lt;/span&gt;(wind);
