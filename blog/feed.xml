    &lt;span class=&quot;hljs-keyword&quot;&gt;let&lt;/span&gt; startX = cx + &lt;span class=&quot;hljs-title function_&quot;&gt;random&lt;/span&gt;(&lt;span class=&quot;hljs-title function_&quot;&gt;random&lt;/span&gt;(&lt;span class=&quot;hljs-number&quot;&gt;5&lt;/span&gt;, &lt;span class=&quot;hljs-number&quot;&gt;25&lt;/span&gt;), width/&lt;span class=&quot;hljs-number&quot;&gt;3&lt;/span&gt;);
    &lt;span class=&quot;hljs-keyword&quot;&gt;let&lt;/span&gt; startY = cy;
  
    &lt;span class=&quot;hljs-keyword&quot;&gt;let&lt;/span&gt; endX = startX + &lt;span class=&quot;hljs-title function_&quot;&gt;random&lt;/span&gt;(&lt;span class=&quot;hljs-title function_&quot;&gt;random&lt;/span&gt;(&lt;span class=&quot;hljs-number&quot;&gt;5&lt;/span&gt;, &lt;span class=&quot;hljs-number&quot;&gt;25&lt;/span&gt;), width/&lt;span class=&quot;hljs-number&quot;&gt;3&lt;/span&gt;);
